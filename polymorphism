#include <iostream>
using namespace std;
class calculator{
    public:
    int multiply(int a,int b){
        return a*b;
    }
    int multiply(double x,double y){
        return x*y;
    }
};
int main() 
{
  calculator obj;
  int res=obj.multiply(10,20);
  double x=obj.multiply(5.2,2.2);
  cout<<res<<" "<<x;
    return 0;
}
