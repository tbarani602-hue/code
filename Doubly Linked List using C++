#include <iostream>
using namespace std;
class DoublyLinkedList {
    struct Node {
        int data;
        Node* prev;
        Node* next;
        Node(int value) : data(value), prev(nullptr), next(nullptr) {}
    };
    Node* head = nullptr;
    Node* tail = nullptr;
public:
    void insertEnd(int value) {
        Node* node = new Node(value);
        if (!head) {
            head = tail = node;
            return;
        }
        node->prev = tail;
        tail->next = node;
        tail = node;
    }
    void displayForward() const {
        for (Node* cur = head; cur; cur = cur->next)
            cout << cur->data << "<->";
        cout << "NULL\n";
    }
    void displayBackward() const {
        for (Node* cur = tail; cur; cur = cur->prev)
            cout << cur->data << "<->";
        cout << "NULL\n";
    }
    ~DoublyLinkedList() {
        while (head) {
            Node* temp = head;
            head = head->next;
            delete temp;
        }
    }
};
int main() {
    DoublyLinkedList list;
    list.insertEnd(10);
    list.insertEnd(20);
    list.insertEnd(30);
    list.insertEnd(40);
    cout << "Forward: ";
    list.displayForward();
    cout << "Backward: ";
    list.displayBackward();
    return 0;
}
