class Stack{
    private int[] arr;
    private int top;
    
    Stack(int size){
        arr = new int[size];
        top = -1;
    }
    void push(int value){
        if(top == arr.length - 1){
            System.out.println("Stack Overflow");
            return;
        }
        top++;
        arr[top] = value;
    }
    int pop(){
        if(top ==-1){
            System.out.println("Stack Underflow");
            return -1;
        }
        return arr[top--];
    }
    int peek(){
        if(top==-1){
                System.out.println("Stack is Empty");
            return -1;
        }
        return arr[top];
    }
    void display(){
        if(top==-1){
            System.out.println("Stack is Empty");
            return;
        }
        for(int i=top;i>=0;i--){
            System.out.println(arr[i]);
        }
    }
}
public class Main{
    public static void main(String[]args){
        Stack stack=new Stack(5);
        stack.push(10);
        stack.push(20);
        stack.push(30);
        stack.push(40);
        System.out.println("Stack elements:");
        stack.display();
        System.out.println("Top:"+stack.peek());
        System.out.println("Deleted:"+stack.pop());
        System.out.println("After pop:");
        stack.display();
    }
}
