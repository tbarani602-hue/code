#include <iostream>
using namespace std;
int linearSearch (int arr[],int n,int target){
    for (int i=0;i<n;i++){
        if(arr[i]==target){
            return i;
        }
    }
    return -1;
}
int main(){
    int arr[]={10,25,30,45,50};
int n=5;
int target=45;
    int result=linearSearch(arr,n,target);
    if(result !=-1)
        cout<<"elements found at index:"<<result;
    else
            cout<<"elements not found";

    return 0;
}
